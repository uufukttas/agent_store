# Kopyala: cp .env.example .env.local  (.env.local git'e girmez)

# Supabase (herkese açık, tarayıcıya gider)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (yalnızca sunucu, asla NEXT_PUBLIC_ öneki alma)
SUPABASE_SERVICE_ROLE_KEY=

# Giriş yapabilecek e-posta alan adı (@ işareti olmadan)
ALLOWED_EMAIL_DOMAIN=gradeup.solutions

# Anthropic (kurumsal API anahtarı, P1'e kadar boş kalabilir)
ANTHROPIC_API_KEY=
