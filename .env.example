# Kopyala: cp .env.example .env.local  (.env.local git'e girmez)

# Supabase (herkese açık, tarayıcıya gider)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (yalnızca sunucu, asla NEXT_PUBLIC_ öneki alma)
SUPABASE_SERVICE_ROLE_KEY=

# Giriş yapabilecek e-posta alan adı (@ işareti olmadan)
ALLOWED_EMAIL_DOMAIN=gradeup.solutions

# Anthropic (kurumsal API anahtarı; bir çalıştırma başlatılana kadar boş kalabilir)
ANTHROPIC_API_KEY=

# Managed Agents webhook imza anahtarı (whsec_...). Console > Manage > Webhooks'ta uç nokta
# oluşturulurken bir kez gösterilir. Webhook alıcı çalışana kadar boş kalabilir.
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# Uzlaştırma uç noktasını (/api/internal/reconcile) çağıran zamanlanmış fonksiyonun gizli
# anahtarı, en az 16 karakter. Örn: openssl rand -hex 24
CRON_SECRET=

# Çalıştırma başına varsayılan bütçe, sent cinsinden (400 = 4 dolar). Boşsa 400.
RUN_DEFAULT_BUDGET_CENTS=400
